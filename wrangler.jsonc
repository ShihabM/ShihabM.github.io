{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "binge-movie",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/tmdb/*"
    ]
  },
  "ratelimits": [
    {
      "name": "TMDB_RATE_LIMITER",
      "namespace_id": "6755895331",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "TMDB_API_KEY"
    ]
  }
}
